# Copy to .env (or set these in your MCP client's `env` block) and fill in your
# values. NEVER commit .env to git.

# Base URL of your Panelica panel's External API. This is the externally
# reachable address of the external-server process (default port 3002).
#
# IMPORTANT: by default Panelica listens on port 3002 directly. If your panel
# host has a firewall (it should), open 3002 only to the IPs that will run the
# MCP server, not to the public internet.
PANELICA_BASE_URL=https://your-panel-host:3002

# Generated in the panel under Settings -> API Keys -> Generate API Key.
PANELICA_API_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shown only once at key creation. Store it in a password manager.
PANELICA_API_SECRET=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Per-request timeout in milliseconds (default 30000).
# PANELICA_TIMEOUT_MS=30000
