# Copy to .env (or set these in your MCP client's `env` block) and fill in your
# values. NEVER commit .env to git.

# Base URL of your Panelica panel's External API.
#
# Recommended (works on any standard install):
#   https://<panel-host>:8443/api/external
#   -- routed through the panel's HTTPS reverse proxy to the external-server.
#   -- 8443 is already open for the panel UI; no extra firewall change needed.
#
# Alternative (only when the MCP server runs ON the panel host itself):
#   http://127.0.0.1:3002
#   -- talks to external-server directly; 3002 is bound to all interfaces
#      but normally firewalled off from the public internet.
PANELICA_BASE_URL=https://your-panel-host:8443/api/external

# Generated in the panel under Settings -> API Keys -> Generate API Key.
PANELICA_API_KEY=pk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Shown only once at key creation. Store it in a password manager.
PANELICA_API_SECRET=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional. Per-request timeout in milliseconds (default 30000).
# PANELICA_TIMEOUT_MS=30000
